# Both keys are optional — the ticker works without them.
#
# CoinGecko: the free public API needs no key (about 30 calls/min, we use ~6).
# A demo key raises the limit and gives a stable rate budget.
# https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# Etherscan: without this the "Gas" item is simply left out of the strip.
# https://etherscan.io/apis
ETHERSCAN_API_KEY=
