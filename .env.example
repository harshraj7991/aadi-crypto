# CoinGecko — free, takes a minute to create: https://www.coingecko.com/en/api
#
# Optional, but strongly recommended. Without it CoinGecko throttles per IP at
# roughly 5-15 calls a minute, which is not enough for:
#   - a 10s ticker refresh (the app drops to 30s on its own when no key is set)
#   - the DeFi / AI / RWA / Memes tabs, whose sector lists get rate-limited out
# A free demo key lifts the limit to 30/min and all of the above just works.
COINGECKO_API_KEY=

# Etherscan — optional. Without it the "Gas" item is left out of the strip.
# https://etherscan.io/apis
ETHERSCAN_API_KEY=
